PROJECT_NAME="FastAPI Repository Pattern"
DEBUG=false

# Async MySQL driver (aiomysql). Same URL works for MariaDB.
DATABASE_URL=mysql+aiomysql://app_user:app_password@localhost:3306/app_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Dev only: create tables on startup. Use Alembic migrations in production.
AUTO_CREATE_TABLES=true

MAX_PAGE_SIZE=100

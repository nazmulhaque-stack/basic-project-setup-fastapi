{
  "secret-leak-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/common/skills/git_helper.py check-secrets",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "quality-checker": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m py_compile app/services/base.py 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
